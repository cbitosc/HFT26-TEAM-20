# AutoEvolve backend configuration. PLACEHOLDERS ONLY. Copy to `.env` (which is git-ignored)
# and edit there. Never put a real key in this file.

# development | test | production
APP_ENV=development

# SQLite only. When unset, defaults to <backend>/data/autoevolve.db (created on first start).
# A relative path in a sqlite URL is resolved against the process working directory.
# DATABASE_URL=sqlite:///./data/autoevolve.db

# Featherless (not called in this milestone; the key may stay empty)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Provisional Generator model
FEATHERLESS_GENERATOR_MODEL=Qwen/Qwen2.5-7B-Instruct

# No Critic model has been approved. Leave blank until one is selected.
# (Qwen/Qwen2.5-32B-Instruct is an experimental candidate only.)
FEATHERLESS_CRITIC_MODEL=

# Seconds
API_TIMEOUT_SECONDS=60

# Candidate-code evaluation. The evaluator runs code in a subprocess, which is NOT a security sandbox.
# Both timeouts are part of the evaluator configuration hash committed when an execution starts.
EVALUATION_TIMEOUT_SECONDS=10
EVALUATION_TOTAL_TIMEOUT_SECONDS=60
# Leave empty: allowed in development/test, refused in production. Set true only on a disposable machine.
ALLOW_UNSANDBOXED_EVALUATION=

# LLM calls (Generator and Critic). Temperature is fixed at 0 in code.
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=1.0
LLM_MAX_TOKENS=2048
GENERATOR_MAX_CODE_CHARS=20000

# Per-execution caps. Exceeding either fails the run and keeps the partial record.
LLM_MAX_CALLS_PER_EXECUTION=6
LLM_MAX_TOTAL_TOKENS_PER_EXECUTION=40000
